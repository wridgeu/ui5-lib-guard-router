{
	"name": "ui5-lib-guard-router-monorepo",
	"private": true,
	"author": "Marco Beier",
	"repository": {
		"type": "git",
		"url": "https://github.com/wridgeu/ui5-lib-guard-router.git"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint packages/ scripts/ tools/ --deny-warnings",
		"lint:fix": "oxlint packages/ scripts/ tools/ --fix",
		"check": "npm run fmt:check && npm run lint && npm run typecheck && npm run check:layout && npm run check:diagrams && npm run test:tooling",
		"check:diagrams": "node ./scripts/check-diagrams.mjs",
		"check:layout": "node ./scripts/check-test-layout.mjs",
		"test:tooling": "node --test \"tools/*.test.mjs\" \"scripts/*.test.mjs\"",
		"typecheck": "tsc --noEmit -p packages/lib/tsconfig.json && tsc --noEmit -p packages/lib/tsconfig.test.json && tsc --noEmit -p packages/demo-app/tsconfig.json && tsc --noEmit -p packages/demo-app/tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
		"build": "npm run build --workspace=packages/lib",
		"start": "npm start --workspace=packages/demo-app",
		"start:flp": "npm run start:flp --workspace=packages/demo-app",
		"start:lib": "npm start --workspace=packages/lib",
		"start:lib:compat:120": "npm run start:compat:120 --workspace=packages/lib",
		"start:lib:compat:120:test": "npm run start:compat:120 --workspace=packages/lib -- --port 8082",
		"start:lib:mutation": "npm start --workspace=packages/lib -- --port 8084",
		"serve:demo": "npm run serve --workspace=packages/demo-app",
		"serve:demo:flp": "npm run serve:flp --workspace=packages/demo-app",
		"serve:demo:test": "npm run serve --workspace=packages/demo-app -- --port 8081",
		"serve:demo:flp:test": "npm run serve:flp --workspace=packages/demo-app -- --port 8083",
		"serve:demo:flp:151:test": "npm run serve:flp --workspace=packages/demo-app -- --port 8085 --framework-version 1.151.0",
		"wdio:qunit": "wdio run packages/lib/test/wdio-qunit.conf.ts",
		"wdio:e2e": "wdio run packages/demo-app/test/wdio.conf.ts",
		"wdio:e2e:flp": "wdio run packages/demo-app/test/wdio-flp.conf.ts",
		"test": "npm run test:qunit && npm run test:e2e",
		"test:full": "npm run test:qunit && npm run test:qunit:compat:120 && npm run test:e2e && npm run test:e2e:flp && npm run test:e2e:flp:151",
		"test:qunit": "node ./scripts/run-with-server.mjs --ready-url http://localhost:8080 --server-script start:lib --test-script wdio:qunit",
		"test:qunit:compat:120": "node ./scripts/run-with-server.mjs --ready-url http://localhost:8082 --server-script start:lib:compat:120:test --test-script wdio:qunit --test-base-url http://localhost:8082",
		"test:e2e": "node ./scripts/run-with-server.mjs --ready-url http://localhost:8081 --server-script serve:demo:test --test-script wdio:e2e --test-base-url http://localhost:8081/index.html",
		"test:e2e:flp": "node ./scripts/run-with-server.mjs --ready-url http://localhost:8083/test/flp.html?sap-ui-xx-viewCache=false --server-script serve:demo:flp:test --test-script wdio:e2e:flp --test-base-url http://localhost:8083/test/flp.html?sap-ui-xx-viewCache=false#app-preview",
		"test:e2e:flp:151": "node ./scripts/run-with-server.mjs --ready-url http://localhost:8085/test/flp.html?sap-ui-xx-viewCache=false --server-script serve:demo:flp:151:test --test-script wdio:e2e:flp --test-base-url http://localhost:8085/test/flp.html?sap-ui-xx-viewCache=false#app-preview",
		"test:mutation": "node ./scripts/mutation-by-file.mjs",
		"stryker": "stryker run",
		"pack:smoke": "node ./scripts/pack-smoke.mjs",
		"pack:check": "npm run pack:check --workspace=packages/lib && npm run pack:smoke",
		"vendor:openui5-router-tests": "node ./scripts/vendor-openui5-router-tests.mjs",
		"verify:openui5-router-vendor": "node ./scripts/verify-openui5-router-vendor.mjs",
		"release:plan": "node ./scripts/release-plan.mjs",
		"commitlint": "commitlint --last",
		"prepare": "husky"
	},
	"lint-staged": {
		"{packages,scripts,tools}/**/*.{ts,js,mjs}": [
			"oxlint --fix --deny-warnings",
			"oxfmt"
		],
		"*.{json,md,yaml,yml}": "oxfmt"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@openui5/types": "^1.154.0",
		"@oxlint/plugins": "^1.94.0",
		"@sapui5/types": "^1.154.0",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/typescript-checker": "^10.1.1",
		"@types/mocha": "^10.0.0",
		"@types/sinon": "^22.0.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@wdio/cli": "^9.33.1",
		"@wdio/local-runner": "^9.33.1",
		"@wdio/mocha-framework": "^9.33.1",
		"@wdio/spec-reporter": "^9.33.1",
		"husky": "^9.1.7",
		"linkedom": "^0.18.15",
		"lint-staged": "^17.6.1",
		"mermaid": "12.3.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"release-please": "^17.11.2",
		"rimraf": "^6.1.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"wdio-qunit-service": "^2.0.2",
		"wdio-ui5-service": "^3.0.12"
	}
}
