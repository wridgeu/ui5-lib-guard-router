{
	"_version": "2.0.0",
	"sap.app": {
		"id": "ui5.guard.router.qunit.fixtures.nested",
		"type": "application",
		"title": "Nested component parent",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5"
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"ui5.guard.router": {}
			}
		},
		"componentUsages": {
			"child": {
				"name": "ui5.guard.router.qunit.fixtures.nested.child",
				"lazy": true
			}
		},
		"rootView": {
			"viewName": "ui5.guard.router.qunit.fixtures.nested.view.App",
			"type": "XML",
			"id": "appView"
		},
		"routing": {
			"config": {
				"routerClass": "ui5.guard.router.Router",
				"type": "View",
				"viewType": "XML",
				"path": "ui5.guard.router.qunit.fixtures.nested.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{ "name": "home", "pattern": "", "target": "home" },
				{ "name": "shell", "pattern": "shell", "target": { "name": "child", "prefix": "child" } }
			],
			"targets": {
				"home": { "name": "Home", "id": "home" },
				"child": { "type": "Component", "usage": "child", "id": "child" }
			}
		}
	}
}
