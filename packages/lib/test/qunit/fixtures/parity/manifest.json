{
	"_version": "2.0.0",
	"sap.app": {
		"id": "ui5.guard.router.qunit.fixtures.parity",
		"type": "application",
		"title": "Native parity parent",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5"
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"ui5.guard.router": {}
			}
		},
		"componentUsages": {
			"child": {
				"name": "ui5.guard.router.qunit.fixtures.parity.childNative",
				"lazy": true
			}
		},
		"rootView": {
			"viewName": "ui5.guard.router.qunit.fixtures.parity.view.App",
			"type": "XML",
			"id": "appView"
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "ui5.guard.router.qunit.fixtures.parity.view",
				"controlId": "app",
				"controlAggregation": "pages",
				"transition": "show",
				"bypassed": {
					"target": "notFound"
				}
			},
			"routes": [
				{ "name": "home", "pattern": "", "target": "home" },
				{
					"name": "shell",
					"pattern": "shell",
					"target": { "name": "child", "prefix": "child", "propagateTitle": true }
				}
			],
			"targets": {
				"home": { "name": "Home", "id": "home", "title": "Home" },
				"notFound": { "name": "NotFound", "id": "notFound", "title": "Not found" },
				"child": { "type": "Component", "usage": "child", "id": "child" }
			}
		}
	}
}
