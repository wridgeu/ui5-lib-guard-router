<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	controllerName="demo.app.reporting.controller.Report">
	<Page
		id="salesPage"
		title="{i18n>salesTitle}"
		titleAlignment="Center"
		showNavButton="true"
		navButtonPress=".onNavBack">
		<content>
			<List
				id="salesList"
				headerText="{i18n>salesListTitle}"
				width="22rem"
				class="sapUiMediumMargin"
				items="{reports>/sales}"
				core:require="{ Currency: 'sap/ui/model/type/Currency', formatMessage: 'sap/base/strings/formatMessage' }">
				<StandardListItem
					title="{ parts: ['i18n>salesQuarter', 'reports>quarter'], formatter: 'formatMessage' }"
					info="{ parts: ['reports>amount', 'reports>currency'], type: 'Currency', formatOptions: { style: 'short' } }" />
			</List>
		</content>
	</Page>
</mvc:View>
