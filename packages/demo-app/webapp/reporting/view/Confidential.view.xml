<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	controllerName="demo.app.reporting.controller.Report">
	<Page
		id="confidentialPage"
		title="{i18n>confidentialTitle}"
		titleAlignment="Center"
		showNavButton="true"
		navButtonPress=".onNavBack">
		<content>
			<VBox id="confidentialContent" class="sapUiMediumMargin" alignItems="Start" renderType="Bare">
				<MessageStrip
					id="confidentialInfo"
					text="{i18n>confidentialInfo}"
					type="Success"
					showIcon="true"
					class="sapUiSmallMarginBottom" />
				<List
					id="salaryList"
					headerText="{i18n>confidentialListTitle}"
					width="22rem"
					core:require="{ Currency: 'sap/ui/model/type/Currency' }">
					<StandardListItem
						id="salaryEngineering"
						title="{i18n>departmentEngineering}"
						info="{ parts: ['reports>/salaryBudgets/engineering/amount', 'reports>/salaryBudgets/engineering/currency'], type: 'Currency', formatOptions: { style: 'short' } }" />
					<StandardListItem
						id="salarySales"
						title="{i18n>departmentSales}"
						info="{ parts: ['reports>/salaryBudgets/sales/amount', 'reports>/salaryBudgets/sales/currency'], type: 'Currency', formatOptions: { style: 'short' } }" />
				</List>
			</VBox>
		</content>
	</Page>
</mvc:View>
