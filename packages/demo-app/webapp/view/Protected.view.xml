<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	controllerName="demo.app.controller.Protected">
	<Page id="protectedPage" title="{i18n>protectedTitle}" titleAlignment="Center" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<VBox class="sapUiMediumMargin" alignItems="Start" renderType="Bare">
				<MessageStrip
					text="{i18n>protectedSuccess}"
					type="Success"
					showIcon="true"
					class="sapUiSmallMarginBottom" />
				<Text
					text="{i18n>protectedInfo}"
					wrapping="true"
					class="sapUiSmallMarginBottom" />
				<FlexBox wrap="Wrap" renderType="Bare">
					<Panel headerText="{i18n>dirtyPanelTitle}" width="22rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<content>
							<Text
								text="{i18n>dirtyPanelInfo}"
								wrapping="true"
								class="sapUiSmallMarginBottom" />
							<CheckBox
								id="dirtyCheckbox"
								text="{i18n>dirtyCheckbox}"
								selected="{form>/isDirty}"
								class="sapUiSmallMarginBottom" />
							<ObjectStatus
								id="dirtyStatus"
								text="{= ${form>/isDirty} ? ${i18n>formDirty} : ${i18n>formClean}}"
								state="{= ${form>/isDirty} ? 'Warning' : 'Success'}"
								icon="{= ${form>/isDirty} ? 'sap-icon://warning' : 'sap-icon://accept'}"
								class="sapUiSmallMarginBottom" />
							<Button
								id="clearDirtyAndGoHomeBtn"
								text="{i18n>clearDirtyAndGoHome}"
								press=".onClearDirtyAndNavHome"
								width="100%" />
						</content>
					</Panel>

					<Panel headerText="{i18n>flpPanelTitle}" width="22rem" class="sapUiSmallMarginBottom">
						<content>
							<Text
								text="{i18n>flpPanelInfo}"
								wrapping="true"
								class="sapUiSmallMarginBottom" />
							<ObjectStatus
								id="protectedUshellStatus"
								text="{= ${runtime>/hasUshellContainer} ? ${i18n>ushellAvailable} : ${i18n>ushellUnavailable}}"
								state="{= ${runtime>/hasUshellContainer} ? 'Success' : 'None'}"
								class="sapUiTinyMarginBottom" />
							<ObjectStatus
								id="protectedFlpDirtyProviderStatus"
								text="{= ${runtime>/flpDirtyProviderActive} ? ${i18n>flpDirtyProviderActive} : ${i18n>flpDirtyProviderInactive}}"
								state="{= ${runtime>/flpDirtyProviderActive} ? 'Success' : 'None'}"
								class="sapUiTinyMarginBottom" />
							<VBox class="sapUiTinyMarginBottom" renderType="Bare">
								<Label text="{i18n>currentHashLabel}" />
								<Text id="protectedCurrentHashText" text="{= ${runtime>/currentHash} || ${i18n>emptyHash}}" />
							</VBox>
							<VBox renderType="Bare">
								<Label text="{i18n>lastActionLabel}" />
								<Text id="protectedLastActionText" text="{= ${runtime>/lastAction} || ${i18n>actionReady}}" />
							</VBox>
							<core:Fragment fragmentName="demo.app.view.SettlementPanel" type="XML" class="sapUiTinyMarginTop" />
						</content>
					</Panel>
				</FlexBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
