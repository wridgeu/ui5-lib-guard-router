<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	controllerName="demo.app.controller.Employees">
	<Page
		id="employeesPage"
		title="{i18n>employeesTitle}"
		showNavButton="true"
		navButtonPress=".onNavBack">
		<content>
			<Panel headerText="{i18n>employeesMetaPanelTitle}">
				<VBox class="sapUiSmallMargin">
					<Text id="employeesMeta" text="{= ${runtime>/employeesMeta} || ${i18n>employeesMetaPlaceholder}}" />
					<Button id="navToEmployee" text="{i18n>navToEmployee}" press=".onNavToEmployee" />
					<Button id="updateMeta" text="{i18n>updateMeta}" press=".onUpdateMeta" />
					<core:Fragment fragmentName="demo.app.view.SettlementPanel" type="XML" />
				</VBox>
			</Panel>
		</content>
	</Page>
</mvc:View>
