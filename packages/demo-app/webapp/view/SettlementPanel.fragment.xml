<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<VBox renderType="Bare" core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
		<ObjectStatus
			id="settlementStatus"
			title="{i18n>settlementLabel}"
			text="{= ${runtime>/lastSettlementStatus} || ${i18n>settlementNotSettled}}"
			state="{runtime>/lastSettlementState}"
			class="sapUiTinyMarginBottom" />
		<ObjectStatus
			id="settlementRouteText"
			title="{i18n>settlementRouteLabel}"
			text="{= ${runtime>/lastSettlementRoute} || (${runtime>/lastSettlementRevision} ? ${i18n>settlementRouteNoMatch} : ${i18n>settlementRoutePending})}"
			class="sapUiTinyMarginBottom" />
		<ObjectStatus
			id="settlementHashText"
			title="{i18n>settlementHashLabel}"
			text="{= ${runtime>/lastSettlementHash} || ${i18n>emptyHash}}" />
		<Text
			id="settlementHashTechnicalText"
			text="{ parts: ['i18n>settlementHashTechnical', 'runtime>/lastSettlementHashTechnical'], formatter: 'formatMessage' }"
			wrapping="true"
			class="sapUiTinyMarginBottom" />
	</VBox>
</core:FragmentDefinition>
