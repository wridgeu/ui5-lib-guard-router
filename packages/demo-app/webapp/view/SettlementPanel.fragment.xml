<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<VBox renderType="Bare" core:require="{ formatMessage: 'sap/base/strings/formatMessage' }">
		<Label text="{i18n>settlementLabel}" />
		<ObjectStatus
			id="settlementStatus"
			text="{= ${runtime>/lastSettlementStatus} || ${i18n>settlementNotSettled}}"
			state="{runtime>/lastSettlementState}"
			class="sapUiTinyMarginBottom" />
		<HBox wrap="Wrap" renderType="Bare">
			<VBox width="9.5rem" renderType="Bare" class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
				<Label text="{i18n>settlementRouteLabel}" />
				<Text id="settlementRouteText" text="{= ${runtime>/lastSettlementRoute} || (${runtime>/lastSettlementRevision} ? ${i18n>settlementRouteNoMatch} : ${i18n>settlementRoutePending})}" />
			</VBox>
			<VBox width="10rem" renderType="Bare" class="sapUiTinyMarginBottom">
				<Label text="{i18n>settlementHashLabel}" />
				<Text id="settlementHashText" text="{= ${runtime>/lastSettlementHash} || ${i18n>emptyHash}}" />
				<Text
					id="settlementHashTechnicalText"
					text="{ parts: ['i18n>settlementHashTechnical', 'runtime>/lastSettlementHashTechnical'], formatter: 'formatMessage' }"
					wrapping="true" />
			</VBox>
		</HBox>
	</VBox>
</core:FragmentDefinition>
