<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	controllerName="demo.app.controller.BaseController">
	<Page id="blockedPage" title="{i18n>blockedTitle}" titleAlignment="Center" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<VBox class="sapUiMediumMargin" alignItems="Start">
				<MessageStrip
					text="{i18n>blockedInfo}"
					type="Error"
					showIcon="true" />
			</VBox>
		</content>
	</Page>
</mvc:View>
