<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	controllerName="demo.app.controller.Admin">
	<Page id="adminPage" title="{i18n>adminTitle}" titleAlignment="Center">
		<content>
			<VBox class="sapUiMediumMargin" alignItems="Start">
				<MessageStrip
					text="{i18n>adminInfo}"
					type="Error"
					showIcon="true" />
			</VBox>
		</content>
	</Page>
</mvc:View>
