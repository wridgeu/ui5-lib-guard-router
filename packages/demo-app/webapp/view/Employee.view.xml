<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	controllerName="demo.app.controller.Employee">
	<Page
		id="employeePage"
		title="{i18n>employeeTitle}"
		showNavButton="true"
		navButtonPress=".onNavBack">
		<content>
			<Panel headerText="{i18n>employeeMetaPanelTitle}">
				<VBox class="sapUiSmallMargin">
					<Text id="employeeMeta" text="{= ${runtime>/employeeMeta} || ${i18n>employeeMetaPlaceholder}}" />
				</VBox>
			</Panel>
		</content>
	</Page>
</mvc:View>
