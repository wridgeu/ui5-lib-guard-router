<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	controllerName="demo.app.controller.Home">
	<Page id="homePage" title="{i18n>homeTitle}" titleAlignment="Center">
		<content>
			<VBox class="sapUiMediumMargin" alignItems="Start" renderType="Bare">
				<MessageStrip
					text="{i18n>homeIntro}"
					type="Information"
					showIcon="true"
					class="sapUiSmallMarginBottom" />

				<FlexBox wrap="Wrap" renderType="Bare">
					<Panel headerText="{i18n>sessionPanelTitle}" width="22rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<content>
							<Text
								text="{i18n>sessionPanelInfo}"
								wrapping="true"
								class="sapUiSmallMarginBottom" />
							<HBox alignItems="Center" class="sapUiTinyMarginBottom">
								<Label text="{i18n>authLabel}" class="sapUiTinyMarginEnd" />
								<ObjectStatus
									id="authStatus"
									text="{= ${auth>/isLoggedIn} ? ${i18n>authLoggedIn} : ${i18n>authLoggedOut}}"
									state="{= ${auth>/isLoggedIn} ? 'Success' : 'Error'}" />
							</HBox>
							<Button
								id="toggleLoginBtn"
								text="{= ${auth>/isLoggedIn} ? ${i18n>logout} : ${i18n>login}}"
								type="Emphasized"
								press=".onToggleLogin"
								width="100%"
								class="sapUiSmallMarginBottom" />
							<HBox wrap="Wrap" class="sapUiTinyMarginBottom">
								<VBox width="9.5rem" renderType="Bare" class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
									<Label text="{i18n>launchModeLabel}" />
									<Text id="launchModeText" text="{= ${runtime>/hasUshellContainer} ? ${i18n>launchModeFlp} : ${i18n>launchModeStandalone}}" />
								</VBox>
								<VBox width="10rem" renderType="Bare" class="sapUiTinyMarginBottom">
									<Label text="{i18n>currentHashLabel}" />
									<Text id="currentHashText" text="{= ${runtime>/currentHash} || ${i18n>emptyHash}}" />
								</VBox>
							</HBox>
							<VBox class="sapUiTinyMarginBottom" renderType="Bare">
								<Label text="{i18n>lastActionLabel}" />
								<Text id="lastActionText" text="{= ${runtime>/lastAction} || ${i18n>actionReady}}" />
							</VBox>
							<core:Fragment fragmentName="demo.app.view.SettlementPanel" type="XML" />
							<ObjectStatus
								id="ushellStatus"
								text="{= ${runtime>/hasUshellContainer} ? ${i18n>ushellAvailable} : ${i18n>ushellUnavailable}}"
								state="{= ${runtime>/hasUshellContainer} ? 'Success' : 'None'}"
								class="sapUiTinyMarginBottom" />
							<ObjectStatus
								id="flpDirtyProviderStatus"
								text="{= ${runtime>/flpDirtyProviderActive} ? ${i18n>flpDirtyProviderActive} : ${i18n>flpDirtyProviderInactive}}"
								state="{= ${runtime>/flpDirtyProviderActive} ? 'Success' : 'None'}" />
						</content>
					</Panel>

					<Panel headerText="{i18n>routerPanelTitle}" width="22rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<content>
							<Text
								text="{i18n>routerPanelInfo}"
								wrapping="true"
								class="sapUiSmallMarginBottom" />
							<Button
								id="navProtectedBtn"
								text="{i18n>navProtected}"
								press=".onNavToProtected"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Text
								text="{i18n>navProtectedHint}"
								wrapping="true"
								class="sapUiTinyMarginBottom" />
							<Button
								id="navBlockedBtn"
								text="{i18n>navBlocked}"
								press=".onNavToBlocked"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="navForbiddenBtn"
								text="{i18n>navForbidden}"
								press=".onNavToForbidden"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="navAdminBtn"
								text="{i18n>navAdmin}"
								press=".onNavToAdmin"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="navToEmployees"
								text="{i18n>navEmployees}"
								press=".onNavToEmployees"
								type="Emphasized"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="navTeamBtn"
								text="{i18n>navTeam}"
								press=".onNavToTeam"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="navReportsBtn"
								text="{i18n>navReports}"
								press=".onNavToReports"
								width="100%" />
						</content>
					</Panel>

					<Panel headerText="{i18n>hashPanelTitle}" width="22rem" class="sapUiSmallMarginBottom">
						<content>
							<Text
								text="{i18n>hashPanelInfo}"
								wrapping="true"
								class="sapUiSmallMarginBottom" />
							<Button
								id="directHashProtectedBtn"
								text="{i18n>hashProtected}"
								press=".onDirectHashToProtected"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="directHashBlockedBtn"
								text="{i18n>hashBlocked}"
								press=".onDirectHashToBlocked"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="directHashForbiddenBtn"
								text="{i18n>hashForbidden}"
								press=".onDirectHashToForbidden"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="directHashMissingBtn"
								text="{i18n>hashMissing}"
								press=".onDirectHashToMissing"
								width="100%"
								class="sapUiTinyMarginBottom" />
							<Button
								id="rapidHashBtn"
								text="{i18n>rapidHash}"
								press=".onRapidHashSequence"
								width="100%" />
						</content>
					</Panel>
				</FlexBox>
			</VBox>
		</content>
	</Page>
</mvc:View>
