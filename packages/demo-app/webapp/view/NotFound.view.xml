<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	controllerName="demo.app.controller.NotFound">
	<Page id="notFoundPage" title="{i18n>notFoundTitle}" titleAlignment="Center" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<VBox class="sapUiMediumMargin" alignItems="Stretch" renderType="Bare">
				<IllustratedMessage
					illustrationType="PageNotFound"
					title="{i18n>notFoundMessageTitle}"
					description="{i18n>notFoundDescription}">
					<additionalContent>
						<Button text="{i18n>goHome}" type="Emphasized" press=".onNavHome" />
					</additionalContent>
				</IllustratedMessage>
				<Panel headerText="{i18n>settlementLabel}" class="sapUiMediumMarginTop">
					<content>
						<core:Fragment fragmentName="demo.app.view.SettlementPanel" type="XML" />
					</content>
				</Panel>
			</VBox>
		</content>
	</Page>
</mvc:View>
