{
	"_version": "2.0.0",
	"sap.app": {
		"id": "demo.parity.native",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "demo.parity.native.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.151.0",
			"libs": {
				"sap.m": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "demo.parity.native.i18n.i18n"
				}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router"
			},
			"routes": [
				{
					"name": "home",
					"pattern": ""
				},
				{
					"name": "page1",
					"pattern": "page1"
				},
				{
					"name": "detail",
					"pattern": "detail/{id}"
				},
				{
					"name": "blocked",
					"pattern": "blocked"
				}
			]
		}
	}
}
