{
	"_version": "3.1.0",
	"site": {
		"payload": {
			"groupsOrder": []
		}
	},
	"catalogs": {},
	"groups": {},
	"visualizations": {},
	"applications": {
		"demo.app": {
			"sap.app": {
				"id": "demo.app",
				"title": "UI5 Guard Router Demo",
				"crossNavigation": {
					"inbounds": {
						"target": {
							"semanticObject": "guardiframe",
							"action": "display",
							"signature": {
								"additionalParameters": "allowed"
							}
						}
					}
				}
			},
			"sap.ui": {
				"technology": "URL"
			},
			"sap.integration": {
				"urlTemplateId": "demo.ui5appruntime"
			}
		},
		"demo.peer": {
			"sap.app": {
				"id": "demo.peer",
				"title": "Peer App",
				"crossNavigation": {
					"inbounds": {
						"target": {
							"semanticObject": "peer",
							"action": "display",
							"signature": {
								"additionalParameters": "allowed"
							}
						}
					}
				}
			},
			"sap.ui5": {
				"componentName": "demo.peer"
			},
			"sap.ui": {
				"technology": "UI5"
			},
			"sap.platform.runtime": {
				"componentProperties": {
					"url": "/peer",
					"asyncHints": {}
				}
			}
		}
	},
	"urlTemplates": {
		"demo.ui5appruntime": {
			"identification": {
				"id": "demo.ui5appruntime"
			},
			"payload": {
				"urlTemplate": "/iframe/ui5appruntime.html{?appId}#{+semanticObject}-{+action}{+routePrefix}{+innerAppRoute}",
				"parameters": {
					"names": {
						"appId": {
							"renameTo": "sap-ui-app-id",
							"value": "{./sap.app/id}"
						},
						"semanticObject": "{./sap.app/crossNavigation/inbounds/target/semanticObject}",
						"action": "{./sap.app/crossNavigation/inbounds/target/action}",
						"routePrefix": "{if({&innerAppRoute:.}) '&/'}",
						"innerAppRoute": "{&innerAppRoute:.}"
					}
				},
				"capabilities": {
					"navigationMode": "embedded",
					"appFrameworkId": "UI5"
				}
			}
		}
	},
	"pages": {}
}
